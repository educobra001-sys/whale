{
  "name": "educobra",
  "version": "1.0.0",
  "description": "EduCobra - multi-teacher education platform",
  "main": "dist/main.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/main.js",
    "start:cluster": "node ./dist/cluster.js",
    "start:worker": "node ./dist/worker.js",
    "start:dev": "cross-env NODE_ENV=dev concurrently \"tsc -watch --preserveWatchOutput\" \"node --watch ./dist/main.js\"",
    "db:start": "node scripts/dev-services.js start && node scripts/init-replica.js",
    "db:stop": "node scripts/dev-services.js stop",
    "seed": "node ./dist/scripts/seed.js",
    "owner:create": "node ./dist/scripts/createOwner.js",
    "test": "tsc && node --test --test-concurrency=1 \"dist/test/**/*.test.js\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "baileys": "^6.7.24",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.1",
    "compression": "^1.8.2",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.4",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
