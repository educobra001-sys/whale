NODE_ENV=dev
PORT=4000
SERVER_IP=127.0.0.1
APP_NAME=EduCobra
PUBLIC_URL=http://127.0.0.1:4000

# Run the background worker inside the API process (fine for local testing).
RUN_WORKER=true
# Number of API processes for `npm run start:cluster` (0 = one per CPU core).
WEB_CONCURRENCY=0

DATABASE_URL=mongodb://127.0.0.1:27117/?replicaSet=rs0&directConnection=true
DB_NAME=educobra
REDIS_URL=redis://127.0.0.1:6479

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=change-me
REFRESH_SECRET=change-me-too
BCRYPT_ROUNDS=11

# Platform owner created by `npm run owner:create`
OWNER_USERNAME=owner
OWNER_EMAIL=owner@educobra.local
OWNER_PASSWORD=change-me-now

# Leave SMTP empty to print verification codes on the server console (offline testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduCobra <no-reply@educobra.local>

CORS_ORIGINS=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# Leave empty to simulate delivery. Messages are then recorded as "simulated".
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
