{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "removeComments": true,
    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": [
    "src/common/interface",
    "src/common/service/s3service.ts",
    "src/common/service/multer",
    "src/common/enum/chat.enum.ts",
    "src/common/enum/subject.enum.ts",
    "src/db/model/chat.model.ts",
    "src/db/model/Teach.Std.ts",
    "src/db/model/session.ts",
    "src/middleware/checkRole.middleware.ts",
    "src/module/chat",
    "src/module/realTime"
  ]
}
